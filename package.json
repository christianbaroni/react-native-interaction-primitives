{
  "name": "react-native-interaction-primitives",
  "version": "0.5.0",
  "packageManager": "yarn@4.13.0",
  "description": "Native interaction primitives for React Native",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/module/index.js"
    },
    "./reanimated": {
      "types": "./lib/typescript/reanimated.d.ts",
      "react-native": "./src/reanimated.ts",
      "import": "./lib/module/reanimated.js",
      "require": "./lib/commonjs/reanimated.js",
      "default": "./lib/module/reanimated.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/src",
    "/lib",
    "/android",
    "/ios",
    "/react-native.config.js",
    "/README.md",
    "/LICENSE",
    "/RNInteractionPrimitives.podspec",
    "!/lib/typescript/example",
    "!/ios/build",
    "!/android/build",
    "!/android/gradle",
    "!/android/gradlew",
    "!/android/gradlew.bat",
    "!/android/local.properties",
    "!/**/__tests__",
    "!/**/__fixtures__",
    "!/**/__mocks__",
    "!/**/.*"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "test:android-ui": "bash tests/verify-android-ui.sh",
    "test:ios-ui": "bash tests/verify-ios-ui.sh",
    "test:native": "bash tests/verify-native.sh",
    "test:ts": "vitest run --config vitest.config.ts && tsc -p tsconfig.vitest.json --noEmit",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .ts,.tsx",
    "lint:prettier": "prettier --check .",
    "format": "prettier --write --log-level warn --ignore-path .prettierignore .",
    "format:check": "prettier --check .",
    "prepare": "yarn build",
    "clean": "del-cli lib",
    "build:js": "bob build",
    "build:types": "yarn exec tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "build": "yarn build:js && yarn build:types",
    "prepack": "yarn build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "interaction",
    "primitives",
    "pager",
    "drawer",
    "gesture",
    "animation"
  ],
  "repository": "https://github.com/christianbaroni/react-native-interaction-primitives",
  "author": "Christian Baroni <7061887+christianbaroni@users.noreply.github.com> (https://github.com/christianbaroni)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christianbaroni/react-native-interaction-primitives/issues"
  },
  "homepage": "https://github.com/christianbaroni/react-native-interaction-primitives#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.81.0",
    "react-native-reanimated": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/metro-config": "0.84.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "del-cli": "^5.0.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^61.1.4",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.20.0",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3",
    "typescript": "^5.0.0",
    "vitest": "^4.0.8"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module"
    ]
  },
  "codegenConfig": {
    "name": "RNInteractionPrimitivesSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "ios": {
      "componentProvider": {
        "RNPagerPageView": "RNPagerPageViewComponentView",
        "RNPagerView": "RNPagerViewComponentView",
        "RNSideDrawerContentView": "RNSideDrawerContentViewComponentView",
        "RNSideDrawerPanelView": "RNSideDrawerPanelViewComponentView",
        "RNSideDrawerView": "RNSideDrawerViewComponentView"
      }
    },
    "android": {
      "javaPackageName": "com.rninteractionprimitives"
    }
  }
}
